# ProjectMeats Production Environment Configuration
# Complete production environment template with security hardening
# Copy this file to .env.prod and customize all values before deployment

# ============================================================================
# DOMAIN AND TLS CONFIGURATION
# ============================================================================

# Your production domain name (REQUIRED - no default)
DOMAIN=your-domain.com

# Email for Let's Encrypt ACME registration (REQUIRED for automatic TLS)
ACME_EMAIL=admin@your-domain.com

# Allowed hosts for Django (include all domains and subdomains)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# Database name
POSTGRES_DB=projectmeats

# Database user (avoid using 'postgres' for security)
POSTGRES_USER=projectmeats

# Database password (REQUIRED - generate a strong password)
# Use: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD_32_CHARS_MIN

# ============================================================================
# CACHE CONFIGURATION (Redis)
# ============================================================================

# Redis password (REQUIRED - generate a strong password)
# Use: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_REDIS_PASSWORD

# ============================================================================
# DJANGO CONFIGURATION
# ============================================================================

# Django secret key (REQUIRED - generate a strong secret key)
# Use: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=CHANGE_ME_TO_SECURE_SECRET_KEY_50_CHARS_MIN

# Debug mode (MUST be False in production)
DEBUG=False

# ============================================================================
# SECURITY SETTINGS (Required for HTTPS)
# ============================================================================

# SSL/HTTPS Redirect
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Secure cookies
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True

# Content Security Policy
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins for CORS (frontend domains)
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=True

# Trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================================================

# SMTP server settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Default 'from' email
DEFAULT_FROM_EMAIL=noreply@your-domain.com
SERVER_EMAIL=server@your-domain.com

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# MONITORING CONFIGURATION (Optional)
# ============================================================================

# Grafana admin password (if using monitoring profile)
GRAFANA_PASSWORD=CHANGE_ME_TO_SECURE_GRAFANA_PASSWORD

# ============================================================================
# COMPANY INFORMATION (Optional)
# ============================================================================

COMPANY_NAME=ProjectMeats
COMPANY_EMAIL=info@your-domain.com
COMPANY_PHONE=+1-555-0123
COMPANY_ADDRESS=123 Business St, City, State 12345

# ============================================================================
# STORAGE CONFIGURATION (Optional - for cloud storage)
# ============================================================================

# AWS S3 Configuration (uncomment if using S3)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=cdn.your-domain.com

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backup retention in days
BACKUP_RETENTION_DAYS=7

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# Before deployment:
# 1. Replace ALL placeholder values above
# 2. Generate secure passwords using: openssl rand -base64 32
# 3. Generate Django secret key using Django's get_random_secret_key()
# 4. Ensure your domain DNS is pointing to your server
# 5. Run: make prod-validate
# 6. Run: make prod-up

# Security checklist:
# □ All passwords are changed from defaults
# □ Django secret key is unique and strong
# □ Domain and ACME email are set correctly
# □ HTTPS settings are enabled
# □ No secrets are committed to version control