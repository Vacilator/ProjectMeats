# ProjectMeats Production Environment Configuration
# Docker deployment with industry best practices

# Domain Configuration
DOMAIN=test-domain.com
ALLOWED_HOSTS=test-domain.com,www.test-domain.com

# Database Configuration (PostgreSQL)
POSTGRES_DB=projectmeats
POSTGRES_USER=projectmeats
POSTGRES_PASSWORD=test-postgres-password

# Redis Configuration
REDIS_PASSWORD=test-redis-password

# Django Configuration  
DJANGO_SECRET_KEY=test-django-secret-key-very-long-and-secure-for-testing
DEBUG=False

# Security Settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://test-domain.com,https://www.test-domain.com
CORS_ALLOW_CREDENTIALS=True

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=test@test.com
EMAIL_PASSWORD=test-app-password
EMAIL_USE_TLS=True

# Monitoring (Optional)
GRAFANA_PASSWORD=test-grafana-admin-password

# Company Information
COMPANY_NAME=ProjectMeats
COMPANY_EMAIL=info@test-domain.com
COMPANY_PHONE=+1-555-0123
COMPANY_ADDRESS=123 Business St, City, State 12345